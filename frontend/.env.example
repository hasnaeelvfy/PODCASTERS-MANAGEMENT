# Relative URL uses Next.js proxy → backend (works on localhost + phone via WiFi)
NEXT_PUBLIC_API_URL=/api

# Dev server binds 0.0.0.0 (see package.json) — accessible via:
#   http://localhost:3000
#   http://192.168.x.x:3000 (your LAN IP — must match backend FRONTEND_URL for OAuth)

# Optional: backend URL for Next.js dev proxy (default localhost:4000)
# BACKEND_URL=http://localhost:4000
