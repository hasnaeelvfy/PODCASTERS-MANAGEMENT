DATABASE_URL="mysql://root:password@localhost:3306/podcast_crm"

# JWT — access token (short-lived) + refresh token (httpOnly cookie)
JWT_SECRET="your-access-token-secret-minimum-32-chars"
JWT_REFRESH_SECRET="your-refresh-token-secret-different-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Encryption (platform tokens)
ENCRYPTION_KEY="your-64-hex-char-key"

# Server
PORT=4000
FRONTEND_URL="http://localhost:3000"
# For phone testing on WiFi, set your PC LAN IP:
# FRONTEND_URL="http://192.168.x.x:3000"
# LAN_IP=192.168.x.x
NODE_ENV="development"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Spotify for Creators OAuth (stats sync)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_SHOW_ID=your_spotify_show_id
# Redirect via Next.js proxy (port 3000 → backend 4000)
# Spotify n'accepte pas "localhost" — utiliser 127.0.0.1
# Chemin exact requis : /api/analytics/oauth/spotify/callback (avec /oauth/)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/api/analytics/oauth/spotify/callback

# SMTP optionnel — peut aussi être configuré dans Paramètres → Notifications
# Gmail : validation 2 étapes + mot de passe d'application (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_gmail_app_password_16_chars_no_spaces
SMTP_FROM=your.email@gmail.com

# Seed
SEED_ADMIN_PASSWORD="ChangeMe123!"
