DATABASE_URL="mysql://root:password@localhost:3306/podcast_crm"

# JWT — access token (short-lived) + refresh token (httpOnly cookie)
JWT_SECRET="your-access-token-secret-minimum-32-chars"
JWT_REFRESH_SECRET="your-refresh-token-secret-different-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Encryption (platform tokens)
ENCRYPTION_KEY="your-64-hex-char-key"

# Server
PORT=4000
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Seed
SEED_ADMIN_PASSWORD="ChangeMe123!"
