generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  editor
  viewer
}

enum GuestLanguage {
  mixte
  francais
  darija
  adefini
}

enum ShortPlatform {
  youtube_shorts
  instagram_reels
  tiktok
  linkedin
  facebook
}

enum SponsorType {
  preroll
  midroll
  postroll
  mention
  partenaire
}

enum SponsorStatus {
  prospect
  contacte
  nego
  confirme
  refuse
  partenaire_recurrent
}

enum TaskStatus {
  pending
  in_progress
  done
  cancelled
}

enum Platform {
  youtube
  spotify
  tiktok
  instagram
}

enum ContractType {
  per_episode
  monthly
  campaign
  recurring
  annual
  affiliate
  package
}

enum ContractCrmStatus {
  prospect
  contacte
  nego
  confirme
  refuse
  partenaire_recurrent
}

enum ContractStatus {
  draft
  active
  paused
  expired
  cancelled
}

enum YoutubeUpdateStatus {
  pending
  success
  failed
  skipped
}

enum YoutubeLogAction {
  description_updated
  comment_pinned
  comment_deleted
  rollback
  description_restored
}

enum YoutubeLogTrigger {
  manual
  cron
  contract_activation
  contract_expiry
}

enum YoutubeQueueAction {
  update_description
  pin_comment
  delete_comment
  restore_description
}

enum YoutubeQueueStatus {
  pending
  processing
  done
  failed
}

model User {
  id            Int            @id @default(autoincrement()) @db.UnsignedInt
  fullname      String         @db.VarChar(255)
  email         String         @unique @db.VarChar(255)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  avatar        String?        @db.VarChar(512)
  role          UserRole       @default(viewer)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  tasks         Task[]         @relation("AssignedTasks")
  notifications Notification[]
  activityLogs  ActivityLog[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  userId    Int       @map("user_id") @db.UnsignedInt
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.Text
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PipelineStage {
  id       Int     @id @default(autoincrement()) @db.UnsignedInt
  name     String  @db.VarChar(100)
  color    String  @default("#8B5CF6") @db.VarChar(7)
  position Int     @unique
  guests   Guest[]

  @@map("pipeline_stages")
}

model Guest {
  id             Int           @id @default(autoincrement()) @db.UnsignedInt
  firstName      String        @default("") @map("first_name") @db.VarChar(100)
  lastName       String        @default("") @map("last_name") @db.VarChar(100)
  company        String?       @db.VarChar(255)
  sector         String?       @db.VarChar(255)
  city           String?       @db.VarChar(100)
  source         String?       @db.VarChar(255)
  contact        String?       @db.VarChar(500)
  language       GuestLanguage @default(adefini)
  stageId        Int           @map("stage_id") @db.UnsignedInt
  shootingDate   DateTime?     @map("shooting_date")
  whyElmaakoul   String?       @map("why_elmaakoul") @db.Text
  emotionalAngle String?       @map("emotional_angle") @db.Text
  notes          String?       @db.Text
  legacyId       String?       @map("legacy_id") @db.VarChar(50)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  interactions   Interaction[]
  episode        Episode?
  tasks          Task[]

  @@index([stageId])
  @@index([shootingDate])
  @@index([legacyId])
  @@map("guests")
}

model Interaction {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  guestId   Int      @map("guest_id") @db.UnsignedInt
  note      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId, createdAt(sort: Desc)])
  @@map("interactions")
}

model Episode {
  id                    Int       @id @default(autoincrement()) @db.UnsignedInt
  guestId               Int       @unique @map("guest_id") @db.UnsignedInt
  episodeNumber         Int?      @map("episode_number")
  title                 String?   @db.VarChar(500)
  recordingDate         DateTime? @map("recording_date") @db.Date
  publicationDate       DateTime? @map("publication_date") @db.Date
  spotifyLink           String?   @map("spotify_link") @db.VarChar(512)
  youtubeLink           String?   @map("youtube_link") @db.VarChar(512)
  youtubeVideoId        String?   @map("youtube_video_id") @db.VarChar(20)
  youtubeViews          Int       @default(0) @map("youtube_views") @db.UnsignedInt
  youtubeLikes          Int       @default(0) @map("youtube_likes") @db.UnsignedInt
  youtubeComments       Int       @default(0) @map("youtube_comments") @db.UnsignedInt
  youtubeDuration       Int?      @map("youtube_duration") @db.UnsignedInt
  youtubeAvgWatchTime   Int?      @map("youtube_avg_watch_time") @db.UnsignedInt
  engagementRate        Decimal?  @map("engagement_rate") @db.Decimal(5, 2)
  lastYoutubeSync       DateTime? @map("last_youtube_sync")
  lastSyncAt            DateTime? @map("last_sync_at")
  youtubeEpisodeUrl     String?   @map("youtube_episode_url") @db.VarChar(512)
  spotifyEpisodeUrl     String?   @map("spotify_episode_url") @db.VarChar(512)
  spotifyEpisodeId      String?   @map("spotify_episode_id") @db.VarChar(100)
  spotifyPublicationDate DateTime? @map("spotify_publication_date") @db.Date
  lastSpotifySync       DateTime? @map("last_spotify_sync")
  listens               Int       @default(0) @db.UnsignedInt
  views                 Int       @default(0) @db.UnsignedInt
  shares                Int       @default(0) @db.UnsignedInt
  completionRate              Decimal?  @map("completion_rate") @db.Decimal(5, 2)
  youtubeDescriptionOriginal  String?   @map("youtube_description_original") @db.LongText
  youtubePinnedCommentId      String?   @map("youtube_pinned_comment_id") @db.VarChar(100)
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  guest                       Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  shorts                      Short[]
  sponsors                    Sponsor[]
  contractEpisodes            ContractEpisode[]

  @@index([youtubeVideoId])
  @@index([publicationDate])
  @@map("episodes")
}

model Short {
  id          Int           @id @default(autoincrement()) @db.UnsignedInt
  episodeId   Int           @map("episode_id") @db.UnsignedInt
  platform    ShortPlatform
  title       String        @db.VarChar(500)
  views       Int           @default(0) @db.UnsignedInt
  likes       Int           @default(0) @db.UnsignedInt
  shares      Int           @default(0) @db.UnsignedInt
  url         String        @db.VarChar(512)
  description String        @db.Text
  publishedAt DateTime?     @map("published_at")
  episode     Episode       @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId])
  @@index([platform])
  @@map("shorts")
}

model Sponsor {
  id          Int           @id @default(autoincrement()) @db.UnsignedInt
  episodeId   Int           @map("episode_id") @db.UnsignedInt
  name        String        @default("") @db.VarChar(255)
  logoUrl     String?       @map("logo_url") @db.VarChar(500)
  websiteUrl  String?       @map("website_url") @db.VarChar(500)
  niche       String?       @db.VarChar(100)
  contactName String?       @map("contact_name") @db.VarChar(255)
  email       String?       @db.VarChar(255)
  phone       String?       @db.VarChar(50)
  sponsorType SponsorType   @default(mention) @map("sponsor_type")
  amount      Decimal       @default(0) @db.Decimal(12, 2)
  status      SponsorStatus @default(prospect)
  notes       String?       @db.Text
  startDate   DateTime?     @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  isRecurring Boolean       @default(false) @map("is_recurring")
  deletedAt   DateTime?     @map("deleted_at")
  episode     Episode       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  contracts   SponsorContract[]

  @@index([episodeId])
  @@index([status, amount])
  @@index([deletedAt])
  @@map("sponsors")
}

model SponsorContract {
  id                         Int               @id @default(autoincrement()) @db.UnsignedInt
  sponsorId                  Int               @map("sponsor_id") @db.UnsignedInt
  contractType               ContractType      @default(per_episode) @map("contract_type")
  crmStatus                  ContractCrmStatus @default(prospect) @map("crm_status")
  contractStatus             ContractStatus    @default(draft) @map("contract_status")
  startDate                  DateTime?         @map("start_date") @db.Date
  endDate                    DateTime?         @map("end_date") @db.Date
  amount                     Decimal           @default(0) @db.Decimal(12, 2)
  currency                   String            @default("MAD") @db.VarChar(3)
  commissionRate             Decimal?          @map("commission_rate") @db.Decimal(5, 2)
  promoMessage               String?           @map("promo_message") @db.Text
  trackingUrl                String?           @map("tracking_url") @db.VarChar(500)
  discountCode               String?           @map("discount_code") @db.VarChar(100)
  youtubeDescriptionTemplate String?           @map("youtube_description_template") @db.Text
  autoUpdateYoutube          Boolean           @default(true) @map("auto_update_youtube")
  notes                      String?           @db.Text
  migratedFromSponsorId      Int?              @unique @map("migrated_from_sponsor_id") @db.UnsignedInt
  deletedAt                  DateTime?         @map("deleted_at")
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")
  sponsor                    Sponsor           @relation(fields: [sponsorId], references: [id], onDelete: Restrict)
  episodes                   ContractEpisode[]
  youtubeLogs                SponsorYoutubeLog[]
  syncQueue                  YoutubeSyncQueue[]

  @@index([sponsorId])
  @@index([contractStatus])
  @@index([crmStatus])
  @@index([startDate, endDate])
  @@index([deletedAt])
  @@map("sponsor_contracts")
}

model ContractEpisode {
  id                  Int                 @id @default(autoincrement()) @db.UnsignedInt
  contractId          Int                 @map("contract_id") @db.UnsignedInt
  episodeId           Int                 @map("episode_id") @db.UnsignedInt
  youtubeVideoId      String?             @map("youtube_video_id") @db.VarChar(50)
  youtubeUpdateStatus YoutubeUpdateStatus @default(pending) @map("youtube_update_status")
  youtubeUpdatedAt    DateTime?           @map("youtube_updated_at")
  youtubeUpdateError  String?             @map("youtube_update_error") @db.Text
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  contract            SponsorContract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  episode             Episode             @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([contractId, episodeId])
  @@index([episodeId])
  @@index([youtubeVideoId])
  @@index([youtubeUpdateStatus])
  @@map("contract_episodes")
}

model SponsorYoutubeLog {
  id              Int               @id @default(autoincrement()) @db.UnsignedInt
  contractId      Int?              @map("contract_id") @db.UnsignedInt
  youtubeVideoId  String            @map("youtube_video_id") @db.VarChar(50)
  action          YoutubeLogAction
  oldDescription  String?           @map("old_description") @db.LongText
  newDescription  String?           @map("new_description") @db.LongText
  oldComment      String?           @map("old_comment") @db.Text
  newComment      String?           @map("new_comment") @db.Text
  triggeredBy     YoutubeLogTrigger @default(manual) @map("triggered_by")
  success         Boolean           @default(false)
  errorMessage    String?           @map("error_message") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  contract        SponsorContract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([youtubeVideoId])
  @@index([action])
  @@index([success])
  @@index([createdAt])
  @@map("sponsor_youtube_logs")
}

model YoutubeSyncQueue {
  id             Int                @id @default(autoincrement()) @db.UnsignedInt
  youtubeVideoId String             @map("youtube_video_id") @db.VarChar(50)
  contractId     Int?               @map("contract_id") @db.UnsignedInt
  action         YoutubeQueueAction
  payload        Json?
  status         YoutubeQueueStatus @default(pending)
  attempts       Int                @default(0) @db.UnsignedInt
  lastError      String?            @map("last_error") @db.Text
  scheduledAt    DateTime           @default(now()) @map("scheduled_at")
  processedAt    DateTime?          @map("processed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  contract       SponsorContract?   @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([scheduledAt])
  @@index([youtubeVideoId])
  @@index([contractId])
  @@map("youtube_sync_queue")
}

model Task {
  id          Int        @id @default(autoincrement()) @db.UnsignedInt
  guestId     Int        @map("guest_id") @db.UnsignedInt
  assignedTo  Int?       @map("assigned_to") @db.UnsignedInt
  title       String     @db.VarChar(255)
  description String?    @db.Text
  dueDate     DateTime?  @map("due_date") @db.Date
  status      TaskStatus @default(pending)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  guest       Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  assignee    User?      @relation("AssignedTasks", fields: [assignedTo], references: [id])

  @@map("tasks")
}

model Notification {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  userId    Int      @map("user_id") @db.UnsignedInt
  type      String?  @db.VarChar(50)
  title     String   @db.VarChar(255)
  content   String   @db.Text
  link      String?  @db.VarChar(512)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type, createdAt])
  @@map("notifications")
}

model ActivityLog {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  message   String   @db.Text
  userId    Int?     @map("user_id") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

model PlatformToken {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  platform      Platform  @unique
  accessToken   String    @map("access_token") @db.Text
  refreshToken  String?   @map("refresh_token") @db.Text
  expiresAt     DateTime? @map("expires_at")
  scope         String?   @db.VarChar(512)
  lastSyncAt    DateTime? @map("last_sync_at")
  lastSyncError String?   @map("last_sync_error") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("platform_tokens")
}

model PlatformStat {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  platform    Platform
  metricKey   String   @map("metric_key") @db.VarChar(100)
  metricValue Decimal  @map("metric_value") @db.Decimal(18, 4)
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@index([platform, metricKey, recordedAt(sort: Desc)])
  @@map("platform_stats")
}

model AppSetting {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  settingKey   String   @unique @map("setting_key") @db.VarChar(100)
  settingValue String?  @map("setting_value") @db.Text
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
